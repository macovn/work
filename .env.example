# Application URL
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# PostgreSQL / Supabase connection string
DATABASE_URL="postgresql://postgres.your-supabase-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgboiler=true"

# JWT Secret — BẮT BUỘC trên production. Tạo bằng: openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_RANDOM_64_HEX_CHARS"

# VAPID Keys for Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa45b736b46487e47a..."
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# Email SMTP Credentials
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="noreply@example.com"
SMTP_PASS="app-specific-password"
SMTP_FROM="Quản lý công việc <noreply@example.com>"

# Zalo OA / ZBS Credentials
ZALO_OA_APP_ID="123456789"
ZALO_OA_SECRET="zalosecretkey"
ZALO_OA_ACCESS_TOKEN="zaloaccesstoken"

# Google OAuth 2.0 / Calendar Integration Credentials (Contract V1.2)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="https://your-app.vercel.app/api/auth/google/callback"
GOOGLE_REFRESH_TOKEN="your-google-oauth-refresh-token"
GOOGLE_CALENDAR_ID="primary"

# Vercel Cron Authorization Secret — BẮT BUỘC trên production (Vercel Cron tự gửi "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET="your-vercel-cron-secret"

# Upstash Redis — TÙY CHỌN: Kích hoạt distributed rate limiting cho môi trường serverless multi-instance.
# Nếu bỏ trống, hệ thống sẽ tự động fallback về in-memory rate limiter.
# Tạo tại: https://console.upstash.com/
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"
