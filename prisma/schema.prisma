generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum Priority {
  LOW      // Bình thường
  MEDIUM   // Gấp
  HIGH     // Rất gấp
}

enum TaskStatus {
  TODO        // Chưa thực hiện
  IN_PROGRESS // Đang thực hiện
  PAUSED      // Tạm dừng
  COMPLETED   // Hoàn thành
  CANCELLED   // Hủy
}

enum NotificationType {
  WARNING
  OVERDUE
  LOGIN_ALERT
}

enum NotificationChannel {
  IN_APP
  WEB_PUSH
  EMAIL
  ZALO
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum TaskType {
  RECURRING // Thường xuyên
  AD_HOC    // Đột xuất
}

enum ComplexityLevel {
  N1 // Hệ số 1.00
  N2 // Hệ số 1.25
  N3 // Hệ số 1.50
  N4 // Hệ số 2.00
  N5 // Hệ số 2.50
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  fullName         String
  role             Role              @default(USER)
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tasks            Task[]            @relation("AssignedTasks")
  evaluatedTasks   Task[]            @relation("EvaluatedTasks")
  logs             NotificationLog[]
  inAppAlerts      InAppNotification[]
  pushSubscriptions PushSubscription[]
}

model JobPosition {
  id            String         @id @default(uuid())
  code          String         @unique // e.g. "VT-DAN-SO"
  name          String         // e.g. "Dân số"
  description   String?
  isActive      Boolean        @default(true)
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  groups        JobTaskGroup[]
  standardTasks StandardTask[]
  tasks         Task[]
}

model JobTaskGroup {
  id            String         @id @default(uuid())
  positionId    String
  position      JobPosition    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  code          String         // e.g. "GRP-01"
  name          String         // Tên nhóm công việc
  weight        Float          @default(100.0) // Trọng số nhóm (%)
  isActive      Boolean        @default(true)
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  standardTasks StandardTask[]
  tasks         Task[]

  @@unique([positionId, code])
}

model StandardTask {
  id               String          @id @default(uuid())
  positionId       String
  position         JobPosition     @relation(fields: [positionId], references: [id], onDelete: Cascade)
  groupId          String
  group            JobTaskGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  code             String          @unique // e.g. "DS-01"
  name             String          // Tên sản phẩm / công việc chuẩn
  unit             String          // Đơn vị tính (ĐVT)
  benchmarkScore   Float           // Điểm chuẩn
  complexityLevel  ComplexityLevel // Mức độ phức tạp N1-N5
  conversionFactor Float           // Hệ số quy đổi (1.00, 1.25, 1.50, 2.00, 2.50)
  isActive         Boolean         @default(true)
  order            Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tasks            Task[]
}

model Task {
  id             String            @id @default(uuid())
  code           String            @unique // Mã công việc TASK-001
  title          String            // Tên công việc
  field          String            // Lĩnh vực
  assigneeId     String            // Người thực hiện
  assignee       User              @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)
  deadline       DateTime          // Ngày hạn
  priority       Priority          @default(LOW) // Mức độ ưu tiên
  taskType       TaskType          @default(RECURRING) // Loại công việc: Thường xuyên / Đột xuất
  status         TaskStatus        @default(TODO) // Trạng thái
  result         String?           // Kết quả
  notes          String?           // Ghi chú
  googleEventId  String?           // ID event Google Calendar tương ứng
  
  // Standard Task Catalog & Score Snapshot Fields
  positionId       String?
  position         JobPosition?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  groupId          String?
  group            JobTaskGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  standardTaskId   String?
  standardTask     StandardTask?   @relation(fields: [standardTaskId], references: [id], onDelete: SetNull)
  unit             String?         // ĐVT snapshot
  benchmarkScore   Float?          // Điểm chuẩn snapshot
  complexityLevel  ComplexityLevel? // Mức độ phức tạp snapshot
  conversionFactor Float?          // Hệ số quy đổi snapshot
  assignedVolume   Float?          // Khối lượng giao
  completedVolume  Float?          // Khối lượng hoàn thành
  assignedScore    Float?          // Điểm giao = assignedVolume * benchmarkScore * conversionFactor
  completedScore   Float?          // Điểm thực hiện = completedVolume * benchmarkScore * conversionFactor
  completionRate   Float?          // Tỷ lệ hoàn thành = completedScore / assignedScore * 100%

  // KPI Scoring Fields
  kpiQuantity    Float?            // Điểm số lượng (0 - 100)
  kpiProgress    Float?            // Điểm tiến độ (0 - 100)
  kpiQuality     Float?            // Điểm chất lượng (0 - 100)
  kpiScore       Float?            // KPI % tổng = (kpiQuantity + kpiProgress + kpiQuality) / 3
  kpiEvaluatorId String?           // ID người chấm điểm
  kpiEvaluator   User?             @relation("EvaluatedTasks", fields: [kpiEvaluatorId], references: [id], onDelete: SetNull)
  kpiEvaluatedAt DateTime?         // Thời điểm chấm điểm
  kpiComment     String?           // Nhận xét của người đánh giá

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  logs           NotificationLog[]
  inAppAlerts    InAppNotification[]
}

model NotificationSetting {
  id                    String   @id @default("default")
  priorityLowHours      Int      @default(4)  // Warning X hours before deadline for Normal
  priorityMediumHours   Int      @default(24) // Warning Y hours before deadline for Medium
  priorityHighHours     Int      @default(48) // Warning Z hours before deadline for High
  enableEmail           Boolean  @default(true)
  enableZalo            Boolean  @default(true)
  enablePush            Boolean  @default(true)
  googleCalendarEnabled Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model NotificationLog {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId           String
  task             Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  notificationType NotificationType
  channel          NotificationChannel
  ruleKey          String              // e.g. PRIORITY_HIGH_48H or OVERDUE
  deadline         DateTime
  scheduledAt      DateTime            @default(now())
  sentAt           DateTime?
  status           NotificationStatus  @default(SENT)
  errorMessage     String?
  createdAt        DateTime            @default(now())

  @@index([userId, taskId, notificationType, ruleKey, deadline])
}

model InAppNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      String   // JSON string { p256dh, auth }
  createdAt DateTime @default(now())
}
